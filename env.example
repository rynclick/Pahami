#--------------------------------------------------------------------
# Pahami environment. Copy to .env and fill in. Never commit .env.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8090/'
app.appTimezone = 'Asia/Jakarta'
app.indexPage = ''

# Database (defaults match docker-compose.yml)
database.default.hostname = db
database.default.database = pahami
database.default.username = pahami
database.default.password = pahami
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Test database (PHPUnit). Uses the same server, separate schema.
database.tests.hostname = db
database.tests.database = pahami_test
database.tests.username = root
database.tests.password = pahami_root
database.tests.DBDriver = MySQLi
database.tests.port = 3306
database.tests.DBPrefix =
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# Models
#--------------------------------------------------------------------
# Which provider handles all calls: meta | baseten
MODEL_PROVIDER = meta
# Optional override for image/PDF calls (e.g. keep vision on meta while MODEL_PROVIDER=baseten).
# Empty = same as MODEL_PROVIDER.
MODEL_VISION_PROVIDER =
# Seconds per model request. A long PDF on Baseten (sent as page images) took 53 s in testing.
MODEL_TIMEOUT = 120

META_API_KEY =
META_BASE_URL = https://api.meta.ai/v1
META_MODEL = muse-spark-1.3

BASETEN_API_KEY =
BASETEN_BASE_URL = https://inference.baseten.co/v1
BASETEN_MODEL = meta-models/muse-spark-open-1026

#--------------------------------------------------------------------
# WhatsApp (Fonnte)
#--------------------------------------------------------------------
FONNTE_TOKEN =
# Secret in the webhook URL: https://<host>/webhook/fonnte?key=<secret> (Fonnte does not sign webhooks)
FONNTE_WEBHOOK_SECRET =
# PHP CLI used to process inbound messages in the background
PHP_CLI = /usr/local/bin/php

#--------------------------------------------------------------------
# Basic auth for /demo (and later /admin). Empty password = no login.
#--------------------------------------------------------------------
DEMO_USER = pahami
DEMO_PASSWORD =
